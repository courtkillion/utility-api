  "unmodeled_provisions": [
    {
      "summary": "SCHEMA GAP - Per Exported kWh Credit of $0.0345 for all kWh delivered to SRP. Schema v1.1 has no charge type for export credits, so this value is NOT machine-readable and any bill computed from this file is wrong for a customer with on-site generation. Fix in v1.2 before this plan is served from an endpoint.",
      "affects": "bill total for customers with on-site generation"
    },
    {
      "summary": "The Export Rate is recalculated effective each May billing cycle as a three-year average of hourly CAISO External Load Aggregation Point prices weighted by hourly exported energy, adjusted by a 5.76% Residential Solar Loss Factor. The current value is posted on SRP's website rather than fixed in the filing.",
      "affects": "Per Exported kWh Credit"
    },
    {
      "summary": "No Export Credit is provided during any period in which the customer elects to sell energy or capacity to SRP under the QF-24 Standard Rate for Qualifying Facilities.",
      "affects": "Per Exported kWh Credit eligibility"
    },
    {
      "summary": "A $0.0017 portion of the System Benefits component funds energy efficiency programs and is capped at $300,000 per customer per SRP fiscal year; past the cap SRP credits $0.0017 per kWh for the remainder of the year.",
      "affects": "System Benefits component of every energy charge"
    },
    {
      "summary": "SRP may raise or lower the Fuel and Purchased Power price, and may adjust the Transmission Cost Adjustment concurrently with changes to its Open Access Transmission Tariff, at its discretion between filings.",
      "affects": "Fuel and Purchased Power Adjustment and Transmission Cost Adjustment components"
    },
    {
      "summary": "Billings are increased or decreased in proportion to taxes, fees, or charges levied by any governmental authority, excluding federal or state income taxes.",
      "affects": "bill total"
    }
  ],

